<Window x:Class="MedHelp.Views.CallDoctorHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вызов врача на дом" Height="550" Width="550"
        MinHeight="450" MinWidth="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Вызов врача на дом" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Адрес:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbAddress" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0,0,0" IsEditable="False"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Телефон:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPhone" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Жалобы:" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtComplaints" Grid.Row="1" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="5" MinHeight="80" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отправить заявку" Width="160" Height="40" Margin="5" Click="BtnSubmit_Click" Background="#EF5350" Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            <Button Content="Отмена" Width="140" Height="40" Margin="5" Click="BtnCancel_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>