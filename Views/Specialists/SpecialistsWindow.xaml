<Window x:Class="MedHelp.Views.SpecialistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Специалисты" Height="600" Width="800"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Выберите врача" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" FontSize="14" VerticalContentAlignment="Center" ToolTip="Поиск по ФИО"/>
                <Button Grid.Column="1" Content="Найти" MinWidth="100" Height="35" Margin="5,0,0,0" Click="BtnSearch_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Специальности" Margin="0,0,10,0">
                <ListBox x:Name="lstSpecialties" SelectionChanged="LstSpecialties_SelectionChanged" DisplayMemberPath="." FontSize="14"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Врачи">
                <DataGrid x:Name="dgDoctors" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="DgDoctors_MouseDoubleClick" SelectionMode="Single" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" AlternatingRowBackground="#FAFAFA" RowHeight="35" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Специальность" Binding="{Binding Specialty}" Width="120"/>
                        <DataGridTextColumn Header="Кабинет" Binding="{Binding CabinetNumber}" Width="80"/>
                        <DataGridTextColumn Header="Стаж" Binding="{Binding ExperienceYears, StringFormat={}{0} лет}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnDoctorDetails" Content="Подробнее" MinWidth="130" Height="40" Margin="5" Click="BtnDoctorDetails_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnBookTicket" Content="Заказать талон" MinWidth="130" Height="40" Margin="5" Click="BtnBookTicket_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Закрыть" MinWidth="100" Height="40" Margin="5" IsCancel="True" Click="BtnClose_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>