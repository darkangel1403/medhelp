<Window x:Class="MedHelp.Views.DoctorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о враче" Height="510" Width="500"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Информация о враче" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="ФИО:" FontWeight="SemiBold" Padding="0"/>
                <TextBlock x:Name="lblFullName" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Специальность:" FontWeight="SemiBold" Padding="0"/>
                <TextBlock x:Name="lblSpecialty" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Кабинет:" FontWeight="SemiBold" Padding="0"/>
                <TextBlock x:Name="lblCabinet" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,66">
            <Grid Margin="0,0,0,87">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Стаж:" FontWeight="SemiBold" Padding="0"/>
                <TextBlock x:Name="lblExperience" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,152,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Образование:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Top"/>
                <TextBlock x:Name="lblEducation" Grid.Column="1" VerticalAlignment="Top" Margin="10,5,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Button Grid.Row="5" Content="Закрыть" Width="120" Height="40" HorizontalAlignment="Center" Click="BtnClose_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
    </Grid>
</Window>