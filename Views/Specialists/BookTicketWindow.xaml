<Window x:Class="MedHelp.Views.BookTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Заказ талона" Height="550" Width="600"
        MinHeight="450" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Заказ талона на приём" FontSize="20" FontWeight="Bold" Foreground="#007ACC"/>
            <TextBlock x:Name="lblDoctorName" Text="" FontSize="14" Foreground="#555555" HorizontalAlignment="Center" Margin="0,5,0,0" FontStyle="Italic"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Дата:" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,15,0"/>
                <DatePicker x:Name="dpDate" Grid.Column="1" SelectedDate="{x:Static sys:DateTime.Today}" FontSize="14" Padding="5"/>
            </Grid>
        </Border>
        <GroupBox Grid.Row="2" Header="Свободные талоны" Padding="10" Margin="0,15,0,0" FontSize="14" FontWeight="SemiBold">
            <DataGrid x:Name="dgFreeTickets" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgFreeTickets_SelectionChanged" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="35" Background="White" AlternatingRowBackground="#F5FAFF" CanUserAddRows="False" ScrollViewer.CanContentScroll="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время приёма" Binding="{Binding VisitDate, StringFormat='dd.MM.yyyy (HH:mm)'}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnConfirmBooking" Content="Подтвердить запись" Click="BtnConfirmBooking_Click" MinWidth="160" Height="40" Margin="5" FontSize="14" Cursor="Hand" IsEnabled="False" Background="#007ACC" Foreground="White" BorderThickness="0" IsDefault="True"/>
            <Button x:Name="btnCancelBooking" Content="Отмена" Click="BtnCancelBooking_Click" MinWidth="130" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
