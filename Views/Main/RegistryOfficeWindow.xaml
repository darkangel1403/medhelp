<Window x:Class="MedHelp.Views.RegistryOfficeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedHelp — Регистратура" Height="700" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Margin="0,0,0,15" FontSize="14">
            <MenuItem Header="_Файл">
                <MenuItem x:Name="mnuExit" Header="Выход" Click="MnuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem x:Name="mnuDirectories" Header="Справочники" Visibility="Collapsed">
                <MenuItem x:Name="miPatients" Header="Пациенты" Click="MiPatients_Click"/>
                <MenuItem x:Name="miDoctors" Header="Врачи" Click="MiDoctors_Click"/>
                <MenuItem x:Name="miStatistics" Header="Статистика" Click="MiStatistics_Click"/>
                <Separator/>
            </MenuItem>
            <MenuItem x:Name="mnuOperations" Header="Операции" Visibility="Collapsed">
                <MenuItem x:Name="mnuRefreshSchedule" Header="Обновить расписание" Click="MnuRefreshSchedule_Click" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="Журналы">
                <MenuItem x:Name="mnuSpecialists" Header="Специалисты" Click="MnuSpecialists_Click"/>
                <MenuItem x:Name="mnuCallHome" Header="Вызов на дом" Click="MnuCallHome_Click"/>
            </MenuItem>
            <MenuItem Header="Помощь">
                <MenuItem Header="О программе" Click="MnuAboutProgram_Click" InputGestureText="F1"/>
                <MenuItem Header="О разработчике" Click="MnuAboutDeveloper_Click" InputGestureText="F2"/>
                <MenuItem Header="Справка" Click="MnuHelp_Click" InputGestureText="F3"/>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="welcomeTextBlock" Text="Добро пожаловать!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,25">
                <Button x:Name="btnSpecialists" Content="Специалисты" MinWidth="260" Height="45" Margin="0,8" FontSize="15" Cursor="Hand" Background="#007ACC" Foreground="White" BorderThickness="0" Click="BtnSpecialists_Click"/>
                <Button x:Name="btnCallHome" Content="Вызвать врача на дом" MinWidth="260" Height="45" Margin="0,8" FontSize="15" Cursor="Hand" Background="#2196F3" Foreground="White" BorderThickness="0" Click="BtnCallHome_Click"/>
                <Button x:Name="btnPersonalAccount" Content="Личный кабинет" MinWidth="260" Height="45" Margin="0,8" FontSize="15" Cursor="Hand" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="BtnPersonalAccount_Click"/>
                <Separator Margin="0,20" Visibility="{Binding ElementName=btnAdminPanel, Path=Visibility}"/>
                <StackPanel x:Name="btnAdminPanel" Orientation="Vertical" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Панель администратора" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#555555" FontSize="16"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="btnAddDoctor" Content="Добавить врача" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Click="BtnAddDoctor_Click"/>
                        <Button x:Name="btnEditDoctor" Content="Изменить врача" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Click="BtnEditDoctor_Click"/>
                        <Button x:Name="btnDeleteDoctor" Content="Удалить врача" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Click="BtnDeleteDoctor_Click"/>
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnAddPatient" Content="Добавить пациента" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Click="BtnAddPatient_Click"/>
                        <Button x:Name="btnEditPatient" Content="Изменить пациента" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#F3E5F5" Foreground="#6A1B9A" BorderThickness="0" Click="BtnEditPatient_Click"/>
                        <Button x:Name="btnDeletePatient" Content="Удалить пациента" MinWidth="180" Height="40" Margin="5" FontSize="14" Cursor="Hand" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Click="BtnDeletePatient_Click"/>
                    </WrapPanel>
                </StackPanel>
                <Button x:Name="btnLogout" Content="Выйти из аккаунта" MinWidth="260" Height="45" Margin="0,20" FontSize="15" Cursor="Hand" Background="#EF5350" Foreground="White" BorderThickness="0" Click="BtnLogout_Click"/>
            </StackPanel>
        </Grid>
        <StatusBar Grid.Row="2" FontSize="13">
            <StatusBarItem>
                <TextBlock x:Name="statusUser" Text="Пользователь: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="statusRole" Text="Роль: "/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="statusConnection" Text="Статус: Подключено" Foreground="Green"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>