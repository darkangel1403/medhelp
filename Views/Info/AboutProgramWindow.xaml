<Window x:Class="MedHelp.Views.AboutProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="400" Width="500"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="🏥 MedHelp" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
            <TextBlock Text="Система учёта пациентов" FontSize="14" Foreground="#777777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="13" Foreground="#333333">
                <Run FontWeight="Bold">Назначение:</Run><LineBreak/>
                Автоматизация работы регистратуры поликлиники.<LineBreak/><LineBreak/>
                <Run FontWeight="Bold">Возможности:</Run><LineBreak/>
                • Электронная запись к врачу.<LineBreak/>
                • Вызов врача на дом.<LineBreak/>
                • Личный кабинет пациента.<LineBreak/>
                • Экспорт данных и печать талонов.<LineBreak/><LineBreak/>
                <Run FontWeight="Bold">Технологии:</Run><LineBreak/>
                C#, .NET 8.0, WPF, MS SQL Server.
            </TextBlock>
        </Border>
        <Button Grid.Row="2" Content="OK" Width="120" Height="40" HorizontalAlignment="Center" Margin="0,20,0,0" Click="BtnOk_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
    </Grid>
</Window>