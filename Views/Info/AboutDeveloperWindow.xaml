<Window x:Class="MedHelp.Views.AboutDeveloperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О разработчике" Height="350" Width="450"
        MinHeight="250" MinWidth="350"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Разработчик" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Латышев Ярослав Юрьевич" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Группа: 82ТП" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="Gray"/>
            <TextBlock Text="Минский государственный колледж цифровых технологий" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Курсовой проект по дисциплине:" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="«Конструирование программ и языки программирования»" TextWrapping="Wrap" HorizontalAlignment="Center" FontStyle="Italic"/>
        </StackPanel>
        <Button Grid.Row="2" Content="OK" Width="120" Height="40" HorizontalAlignment="Center" Margin="0,20,0,0" Click="BtnOk_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
    </Grid>
</Window>
