<Window x:Class="MedHelp.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="420" Width="450"
        MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Смена пароля" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Старый пароль:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <PasswordBox x:Name="pwdOld" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="8,0,0,0" Height="32"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Новый пароль:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <PasswordBox x:Name="pwdNew" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="8,0,0,0" Height="32"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Повтор:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <PasswordBox x:Name="pwdConfirm" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="8,0,0,0" Height="32"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" MinWidth="130" Height="40" Margin="5" Click="BtnSave_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            <Button Content="Отмена" MinWidth="110" Height="40" Margin="5" Click="BtnCancel_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
