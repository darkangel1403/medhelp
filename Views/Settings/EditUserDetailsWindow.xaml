<Window x:Class="MedHelp.Views.EditUserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личные данные" Height="500" Width="450"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Личные данные" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="ФИО:" FontWeight="SemiBold" Padding="0"/>
                <TextBox x:Name="tbFullName" Grid.Column="1" BorderThickness="0" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Логин:" FontWeight="SemiBold" Padding="0"/>
                <TextBox x:Name="tbLogin" Grid.Column="1" BorderThickness="0" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Адрес:" FontWeight="SemiBold" Padding="0"/>
                <ComboBox x:Name="cmbAddress" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0,0,0" IsEditable="False"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Телефон:" FontWeight="SemiBold" Padding="0"/>
                <TextBox x:Name="tbPhone" Grid.Column="1" BorderThickness="0" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" MinWidth="130" Height="40" Margin="5" Click="BtnSave_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            <Button Content="Сменить пароль" MinWidth="140" Height="40" Margin="5" Click="BtnChangePassword_Click" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" MinWidth="110" Height="40" Margin="5" Click="BtnCancel_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>