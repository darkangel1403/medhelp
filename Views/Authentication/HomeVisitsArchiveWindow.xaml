<Window x:Class="MedHelp.Views.HomeVisitsArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Архив вызовов" 
        Height="800" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" 
        FontSize="16"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="История вызовов" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" 
                  x:Name="dgArchive" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" 
                  BorderBrush="#E0E0E0" 
                  RowHeight="40" 
                  FontSize="15" 
                  AlternatingRowBackground="#FAFAFA" 
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding RequestDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="180"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="Red"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Жалобы" Binding="{Binding Complaints}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Экспорт (Ctrl+S)" MinWidth="180" Height="45" Margin="5" Click="BtnExport_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Закрыть" MinWidth="150" Height="45" Margin="5" Click="BtnClose_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>