<Window x:Class="MedHelp.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedHelp — Регистрация" Height="750" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Регистрация нового пользователя" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="ФИО:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFullName" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Логин:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtLogin" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Телефон:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPhone" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Адрес:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbAddress" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0" IsEditable="False"/>
            </Grid>
        </Border>
        <Border Grid.Row="5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Пароль:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pwdPassword" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Повтор:" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pwdConfirm" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Margin="5,0,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Зарегистрироваться" Width="180" Height="40" Margin="5" Click="BtnRegister_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Width="140" Height="40" Margin="5" Click="BtnCancel_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>