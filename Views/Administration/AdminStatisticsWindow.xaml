<Window x:Class="MedHelp.Views.AdminStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Статистика" Height="550" Width="800"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Статистика" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TabControl Grid.Row="1">
            <TabItem Header="Записи по специальностям">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <lvc:CartesianChart Series="{Binding SpecialtySeries}" LegendLocation="Right">
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество" LabelFormatter="{Binding YFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Специальность" Labels="{Binding SpecialtyLabels}"/>
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                    <TextBlock Grid.Row="1" Text="Топ специалистов" FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="Динамика вызовов">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <lvc:CartesianChart Series="{Binding VisitsSeries}" LegendLocation="Top">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Дата" Labels="{Binding VisitLabels}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Вызовы" LabelFormatter="{Binding YFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                    <TextBlock Grid.Row="1" Text="За последние 7 дней" FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="Закрыть" Width="130" Height="40" HorizontalAlignment="Center" Margin="0,20,0,0" Click="BtnClose_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
    </Grid>
</Window>