<Window x:Class="MedHelp.Views.DoctorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка врача" Height="550" Width="450"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Данные врача" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="ФИО:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="tbFullName" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Специальность:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="tbSpecialty" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Кабинет:" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="tbCabinet" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Стаж (лет):" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="tbExp" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Образование:" Padding="0" FontWeight="SemiBold"/>
                <TextBox x:Name="tbEdu" Grid.Row="1" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="5" MinHeight="60" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" MinWidth="130" Height="40" Margin="5" Click="BtnSave_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
            <Button Content="Отмена" MinWidth="110" Height="40" Margin="5" Click="BtnCancel_Click" Background="#F5F5F5" Foreground="#333333" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>